# Copia este archivo a `.env` EN EL DROPLET (NO lo commitees). Lo leen el deploy y pm2.
PORT=5555                     # Puerto local de esta app. SvelteKit usa 300x (3000, 3100, 3200...)
HOST=127.0.0.1                # Siempre localhost; nginx hace el proxy reverso
ORIGIN=https://capital.moibe.me    # Requerido por SvelteKit para aceptar POST/form-actions en prod
DATABASE_URL=./local.db       # SQLite (better-sqlite3 + drizzle)
SESSION_SECRET=               # Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
